# Neon Postgres — console.neon.tech → Project → Connect
# Prefer the pooled URL (host contains "-pooler") for this starter.
# Example:
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# App URL (no trailing slash)
# Local: http://localhost:3000
# Prod:  https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000
